rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'marhaniza05@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Validation Blueprint for TeacherAccount
    function isValidTeacherAccount(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'nip',
        'email',
        'subject',
        'grade',
        'isActive',
        'isDemo',
        'activatedAt',
        'ownerId'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'nip',
        'email',
        'subject',
        'grade',
        'isActive',
        'isDemo',
        'activatedAt',
        'ownerId'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 40 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
      data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 80 &&
      data.grade is string && data.grade.size() >= 2 && data.grade.size() <= 40 &&
      data.isActive is bool &&
      data.isDemo is bool &&
      data.activatedAt is string && data.activatedAt.size() >= 1 && data.activatedAt.size() <= 60 &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId == request.auth.uid;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /teacher_accounts/{teacherId} {
      allow get: if isVerifiedUser() && isValidId(teacherId) && (
        existing().ownerId == request.auth.uid ||
        existing().email == request.auth.token.email ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().ownerId == request.auth.uid ||
        existing().email == request.auth.token.email ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(teacherId) &&
        incoming().id == teacherId &&
        isValidTeacherAccount(incoming()) &&
        (isAdmin() || incoming().email == request.auth.token.email);

      allow update: if isVerifiedUser() &&
        isValidId(teacherId) &&
        isValidTeacherAccount(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nip', 'subject', 'grade', 'isActive'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(teacherId) && (
        isAdmin() || existing().ownerId == request.auth.uid
      );
    }
  }
}
